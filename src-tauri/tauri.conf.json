{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeon Master Studio",
  "version": "0.1.0",
  "identifier": "studio.dungeonmaster.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Dungeon Master Studio",
      "width": 1240,
      "height": 780,
      "minWidth": 1080,
      "minHeight": 580,
      "decorations": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
